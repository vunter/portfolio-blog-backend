	<!-- F-001: Dev-only dependencies isolated in profile -->
	<profiles>
		<profile>
			<id>dev</id>
			<dependencies>
				<dependency>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-devtools</artifactId>
					<scope>runtime</scope>
					<optional>true</optional>
				</dependency>
			</dependencies>
		</profile>
		<!--
		  A5/H3: Release builds must not ship dev-only resources. The default
		  build packages application-dev/local/e2e/nitro.properties (committed
		  dev JWT secret / admin passwords, home-LAN IPs) and the dev/ seed
		  data into the JAR. This profile removes them; the Dockerfile and the
		  deploy workflow activate it with -Prelease-jar.
		  The two <resource> blocks replicate spring-boot-starter-parent's
		  resource config (filtered application* files + everything else
		  unfiltered) because profile-level <resources> REPLACE the inherited
		  list — dropping the split would break @..@ property filtering.
		  Verified: cloud/cluster/prod/qa profiles reference none of the
		  excluded files (dev/ is only read by @Profile("dev") DevDataInitializer).
		-->
		<profile>
			<id>release-jar</id>
			<build>
				<resources>
					<resource>
						<directory>${basedir}/src/main/resources</directory>
						<filtering>true</filtering>
						<includes>
							<include>**/application*.yml</include>
							<include>**/application*.yaml</include>
							<include>**/application*.properties</include>
						</includes>
						<excludes>
							<exclude>**/application-dev.properties</exclude>
							<exclude>**/application-local.properties</exclude>
							<exclude>**/application-e2e.properties</exclude>
							<exclude>**/application-nitro.properties</exclude>
						</excludes>
					</resource>
					<resource>
						<directory>${basedir}/src/main/resources</directory>
						<excludes>
							<exclude>**/application*.yml</exclude>
							<exclude>**/application*.yaml</exclude>
							<exclude>**/application*.properties</exclude>
							<exclude>dev/**</exclude>
						</excludes>
					</resource>
				</resources>
			</build>
		</profile>
		<!--
		  Activate in CI to run OWASP Dependency-Check as part of `verify`.
		  Local builds skip it because the NVD download is multi-minute and
		  requires an NVD_API_KEY env var.
		-->
		<profile>
			<id>dep-scan</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.owasp</groupId>
						<artifactId>dependency-check-maven</artifactId>
						<executions>
							<execution>
								<id>dependency-check</id>
								<phase>verify</phase>
								<goals>
									<goal>check</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
				<executions>
					<!--
					  H2 is dev-only. Excluding it at the `repackage` goal level
					  (not the plugin-level <configuration>) keeps it on the
					  spring-boot:run classpath for local dev while keeping the
					  prod fat-jar slim. The plugin-level <excludes> above
					  applies to every goal including `run`, which would break
					  the H2-backed dev profile.
					-->
					<execution>
						<id>repackage</id>
						<goals>
							<goal>repackage</goal>
						</goals>
						<configuration>
							<excludes>
								<exclude>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</exclude>
								<exclude>
									<groupId>com.h2database</groupId>
									<artifactId>h2</artifactId>
								</exclude>
								<exclude>
									<groupId>io.r2dbc</groupId>
									<artifactId>r2dbc-h2</artifactId>
								</exclude>
							</excludes>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- F-005: Enforce minimum Maven/Java versions and ban duplicate deps -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-versions</id>
						<goals><goal>enforce</goal></goals>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>[3.9.0,)</version>
								</requireMavenVersion>
								<requireJavaVersion>
									<version>[25,)</version>
								</requireJavaVersion>
								<banDuplicatePomDependencyVersions/>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>@{argLine}</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.13</version>
				<configuration>
					<excludes>
						<!-- Main application class -->
						<exclude>dev/catananti/PortfolioBlogV2Application.class</exclude>
						<!-- Dev-only data initializer (not production code) -->
						<exclude>dev/catananti/config/DevDataInitializer.class</exclude>
						<!-- Spring @Bean configuration classes (no business logic) -->
						<exclude>dev/catananti/config/RedisConfig.class</exclude>
						<exclude>dev/catananti/config/R2dbcConfig.class</exclude>
						<exclude>dev/catananti/config/OpenApiConfig.class</exclude>
						<exclude>dev/catananti/config/JacksonConfig.class</exclude>
						<exclude>dev/catananti/config/StaticResourceConfig.class</exclude>
						<exclude>dev/catananti/config/VirtualThreadConfig.class</exclude>
						<exclude>dev/catananti/config/SnowflakeIdConfig.class</exclude>
						<exclude>dev/catananti/config/CompressionConfig.class</exclude>
						<exclude>dev/catananti/config/DevCacheConfig.class</exclude>
						<exclude>dev/catananti/config/ResilienceConfig.class</exclude>
						<exclude>dev/catananti/config/I18nConfig.class</exclude>
						<exclude>dev/catananti/config/RequestLoggingConfig.class</exclude>
						<!-- R2DBC repository interfaces -->
						<exclude>dev/catananti/repository/**</exclude>
						<!-- R2DBC converters (trivial) -->
						<exclude>dev/catananti/config/converter/**</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!--
			  Q11.5: OWASP Dependency-Check.
			  Threshold dropped from 9 (critical-only) to 7 so HIGH-severity CVEs
			  fail the build. The check binds to the verify phase via the
			  `dep-scan` profile (skipped in everyday local builds because the
			  NVD download is multi-minute). CI activates `dep-scan` so the
			  check actually runs on PRs.
			-->
			<plugin>
				<groupId>org.owasp</groupId>
				<artifactId>dependency-check-maven</artifactId>
				<version>12.1.1</version>
				<configuration>
					<failBuildOnCVSS>7</failBuildOnCVSS>
					<!-- NVD H2 DB lives here (outside ~/.m2) so CI can cache it with a
					     key independent of the pom hash. Before this, a dependency bump
					     busted setup-java's pom-hashed maven cache and forced a full
					     multi-hundred-MB NVD re-download — exactly when the scan matters
					     most. autoUpdate stays on for small incremental NVD deltas. -->
					<dataDirectory>${project.basedir}/.dependency-check/data</dataDirectory>
					<autoUpdate>true</autoUpdate>
					<suppressionFiles>
						<suppressionFile>dependency-check-suppressions.xml</suppressionFile>
					</suppressionFiles>
					<nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
					<skipProvidedScope>true</skipProvidedScope>
					<skipRuntimeScope>false</skipRuntimeScope>
					<!-- OSS Index (ossindex.sonatype.org) now returns 401 (auth required);
					     its analyzer exception fails the build even though the NVD-based
					     CVSS>=7.0 gate passes. NVD stays the CVE source of truth — disable
					     the supplementary OSS Index analyzer. -->
					<ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
				</configuration>
			</plugin>
			<!--
			  Maven Failsafe runs integration tests (*IT or *IntegrationTest) in
			  the integration-test/verify phases. Surefire above handles fast
			  unit tests; this split keeps `mvn test` quick and `mvn verify`
			  comprehensive.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<argLine>@{argLine}</argLine>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
