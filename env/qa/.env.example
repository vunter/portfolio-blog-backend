# QA environment — segredos via Doppler.
# Único valor que precisa estar no host:
DOPPLER_TOKEN=<service-token-do-projeto-portfolio-blog-config-qa>

# Todas as outras envs (DATABASE_URL, DB_USERNAME, DB_PASSWORD, REDIS_*,
# JWT_SECRET, CORS_ALLOWED_ORIGINS, APP_URL, S3_*, DD_API_KEY, OAuth, etc.)
# vêm do Doppler em tempo de execução via:
#   doppler run --config qa -- docker compose up -d
