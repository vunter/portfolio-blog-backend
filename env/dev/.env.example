# ====================================================================
# Dev environment example. Copy to .env and preencher.
# Dois modos: Vault (primário) ou secrets locais (fallback).
# ====================================================================

# ─── Modo A: usar Vault (se tiver acesso ao K3s 192.168.1.193) ───
# Descomente e preencha:
# VAULT_ADDR=http://192.168.1.193:30820
# VAULT_ROLE_ID=<seu-role-id>
# VAULT_SECRET_ID=<seu-secret-id>

# ─── Modo B: secrets locais (fallback se Vault não disponível) ───
DB_USERNAME=postgres
DB_PASSWORD=postgres
REDIS_PASSWORD=redis
JWT_SECRET=__GENERATE_WITH__openssl_rand_base64_64
GRAFANA_PASSWORD=__GENERATE_WITH__openssl_rand_base64_32

# reCAPTCHA — use as chaves de teste do Google em dev
# https://developers.google.com/recaptcha/docs/faq#id-like-to-run-automated-tests-with-recaptcha
RECAPTCHA_ENABLED=true
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_SCORE_THRESHOLD=0.5

# Admin seed (opcional)
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=__SET_LOCAL_PASSWORD__
ADMIN_NAME=Administrator

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://127.0.0.1:3000

# Snowflake (manter 1 em dev)
SNOWFLAKE_NODE_ID=1

# Datadog (opcional em dev — deixe vazio se não quiser APM local)
DD_API_KEY=
DD_ENV=development
DD_HOSTNAME=dev-localhost

# Storage local (MinIO) — apenas se ativar o profile s3
STORAGE_TYPE=local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=media
S3_PUBLIC_URL=http://localhost:9000/media
