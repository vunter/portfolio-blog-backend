# PROD environment — segredos via Doppler.
# Único valor que precisa estar no host:
DOPPLER_TOKEN=<service-token-do-projeto-portfolio-blog-config-prd>

# Todas as outras envs vêm do Doppler em tempo de execução via:
#   doppler run --config prd -- docker compose -f docker-compose.infra.yml up -d
#   doppler run --config prd -- docker compose -f docker-compose.cloud.yml up -d
