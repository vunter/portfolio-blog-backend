<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!-- Add suppressions for known false positives here -->
    <!-- Example:
    <suppress>
        <notes><![CDATA[False positive - not applicable to our usage]]></notes>
        <cve>CVE-XXXX-XXXXX</cve>
    </suppress>
    -->

    <!--
      CVE-2026-40981/40982/41002/41004 are Spring Cloud Config SERVER vulnerabilities
      (directory traversal, Google Secrets Manager cross-project access, Git-clone
      TOCTOU). This service does NOT run a Config Server — it uses spring-cloud-(starter-)
      vault-config as a config CLIENT with a Vault backend. Dependency-Check matches these
      CVEs to the vault-config artifacts via the shared spring_cloud_config CPE, which is a
      false positive (the vulnerable config-server code paths do not ship here). Re-evaluate
      if a spring-cloud-config-server dependency is ever introduced.
    -->
    <suppress>
        <notes><![CDATA[CPE false positives: Spring Cloud Config Server CVEs matched against spring-cloud-(starter-)vault-config, which is a config client (Vault backend), not a config server.]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.cloud/spring-cloud-.*vault.*$</packageUrl>
        <cve>CVE-2026-40981</cve>
        <cve>CVE-2026-40982</cve>
        <cve>CVE-2026-41002</cve>
        <cve>CVE-2026-41004</cve>
    </suppress>
</suppressions>
